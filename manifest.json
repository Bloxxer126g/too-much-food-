{
  "name": "Too Much Food!",
  "description": "Don't order too much food from Sainsbury's",
  "version": "1.1",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.webp"
  },

  "content_scripts": [
    {
        "js": ["content.js"],
        "matches": [
            "https://*.sainsburys.co.uk/*"
        ] 
    }
  ]
}

